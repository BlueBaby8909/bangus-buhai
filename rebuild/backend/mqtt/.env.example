# Private file: backend/mqtt/.env. Never copy prototype or auth settings here.
BB_MQTT_MODE=disabled
BB_MQTT_HOST=127.0.0.1
BB_MQTT_PORT=58883
BB_MQTT_PREFIX=bangusbuhai-rebuild
BB_MQTT_CLIENT_ID=bb-rebuild-ingestion
BB_MQTT_CA_FILE=
BB_MQTT_CERTIFICATE_FILE=
BB_MQTT_KEY_FILE=
# certificate (rollback/default) or password; both always require verified TLS.
BB_MQTT_AUTH_MODE=certificate
# Private JSON with exactly username/password; never paste passwords into this file.
BB_MQTT_CREDENTIAL_FILE=
# Owner-recorded release gates; simulated tests do not satisfy live qualification.
BB_MQTT_BROKER_QUALIFIED=false
BB_MQTT_FIRMWARE_QUALIFIED=false
