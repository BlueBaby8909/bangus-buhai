# Authentication only. Database settings remain in rebuild/database/.env.
# Generate a private file/key: python -m backend.features.accounts.owner init-config
BB_AUTH_MODE=development
BB_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
BB_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
BB_AUTH_TOKEN_KEY=GENERATE-A-PRIVATE-FERNET-KEY
BB_AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://127.0.0.1:8001
BB_AUTH_JWT_ALGORITHM=ES256
