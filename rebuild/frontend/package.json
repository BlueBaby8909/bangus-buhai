{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:release": "node scripts/check-release.mjs && vite build && node scripts/check-dist.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "lint": "oxlint --deny-warnings src scripts vite.config.js",
