{
  "$id": "urn:bangusbuhai:device:v1:ack",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "boot_id": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Boot Id",
      "type": "string"
    },
    "device_id": {
      "maxLength": 15,
      "minLength": 15,
      "pattern": "^BB-[0-9A-F]{12}$",
      "title": "Device Id",
      "type": "string"
    },
    "event_kind": {
      "enum": [
        "telemetry",
        "command_result"
      ],
      "title": "Event Kind",
      "type": "string"
    },
    "result": {
      "enum": [
        "stored",
        "duplicate"
      ],
      "title": "Result",
      "type": "string"
    },
    "schema_version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seq": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "device_id",
    "boot_id",
    "seq",
    "event_kind",
    "result"
  ],
  "title": "Acknowledgement",
  "type": "object"
}
